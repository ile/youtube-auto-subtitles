{
	"manifest_version": 3,
	"name": "YouTube Auto Subtitles",
	"version": "1.0.2",
	"permissions": [
		"scripting",
		"activeTab"
	],
	"host_permissions": [
		"https://*.youtube.com/*"
	],
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": [
				"https://*.youtube.com/watch*"
			],
			"js": [
				"content.js"
			],
			"run_at": "document_idle"
		}
	],
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	}
}